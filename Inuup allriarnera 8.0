html<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecosystem Master Hub v8.0: Absolute Freedom</title>
    <style>
        :root {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --accent-blue: #58a6ff;
            --accent-red: #ff7b72;
            --accent-purple: #d2a8ff;
            --accent-teal: #39c5bb;
            --accent-orange: #f0883e;
            --accent-green: #2ea44f;
            --accent-gold: #f2c94c;
            --text-main: #c9d1d9;
            --text-muted: #8b949e;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            margin: 0;
            padding: 12px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 500px;
            background: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            box-sizing: border-box;
        }

        h1 { font-size: 22px; margin-top: 0; text-align: center; color: #fff; }
        p.subtitle { text-align: center; color: var(--text-muted); font-size: 13px; margin-bottom: 24px; }
        h2.section-title { font-size: 14px; color: #fff; border-bottom: 1px solid #30363d; padding-bottom: 6px; margin-top: 28px; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.5px; }
        .input-group { margin-bottom: 16px; }
        label { display: block; font-size: 13px; margin-bottom: 6px; font-weight: 600; }

        .label-val { float: right; font-weight: bold; }
        .blue-val { color: var(--accent-blue); }
        .red-val { color: var(--accent-red); }
        .purple-val { color: var(--accent-purple); }
        .teal-val { color: var(--accent-teal); }
        .orange-val { color: var(--accent-orange); }
        .green-val { color: var(--accent-green); }
        .gold-val { color: var(--accent-gold); }

        input[type="range"] { width: 100%; margin-top: 4px; }
        input#burnout { accent-color: var(--accent-blue); }
        input#hoursPerWeek, input#overhead { accent-color: var(--accent-red); }
        input#conversionRate { accent-color: var(--accent-purple); }
        input#manualHours { accent-color: var(--accent-teal); }
        input#sweepRate { accent-color: var(--accent-gold); }

        input[type="number"] {
            width: 100%; padding: 10px; background: #0d1117; border: 1px solid #30363d;
            border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;
        }

        .results-box { background: #0d1117; border-left: 4px solid var(--accent-green); padding: 14px; border-radius: 4px; margin-top: 14px; }
        .results-box.blue-b { border-left-color: var(--accent-blue); }
        .results-box.red-b { border-left-color: var(--accent-red); }
        .results-box.purple-b { border-left-color: var(--accent-purple); }
        .results-box.teal-b { border-left-color: var(--accent-teal); }
        .results-box.gold-b { border-left-color: var(--accent-gold); }

        .result-item { margin-bottom: 10px; }
        .result-item:last-child { margin-bottom: 0; }
        .result-label { font-size: 12px; color: var(--text-muted); }
        .result-value { font-size: 18px; font-weight: bold; color: #fff; }

        .notification-card { background: #0d1117; border: 1px solid #30363d; border-radius: 8px; padding: 16px; margin-top: 14px; }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .badge-live { background: rgba(46, 164, 79, 0.15); color: var(--accent-green); font-size: 10px; padding: 2px 8px; border-radius: 12px; font-weight: bold; text-transform: uppercase; }
        .metric-row { display: flex; justify-content: space-between; margin-bottom: 12px; background: #161b22; padding: 8px; border-radius: 4px; }
        .metric-pill { font-size: 11px; text-align: center; width: 32%; }
        .pill-lbl { color: var(--text-muted); font-size: 10px; margin-bottom: 2px; }
        .pill-val { font-weight: bold; color: #fff; }
        .btn-row { display: flex; justify-content: space-between; margin-top: 12px; }
        .btn-action { width: 48%; padding: 10px; border: none; border-radius: 6px; font-weight: bold; font-size: 13px; cursor: pointer; }
        .btn-approve { background: var(--accent-green); color: #fff; }
        .btn-reject { background: #21262d; color: var(--accent-red); border: 1px solid #30363d; }

        .writer-panel { background: #0d1117; border: 1px solid #30363d; border-radius: 8px; padding: 14px; margin-top: 14px; display: none; }
        .writer-title { font-size: 14px; font-weight: bold; color: #fff; margin-bottom: 6px; }
        .writer-body { font-size: 12px; color: var(--text-muted); line-height: 1.5; background: #161b22; padding: 10px; border-radius: 4px; height: 120px; overflow-y: auto; white-space: pre-wrap; font-family: monospace; }

        .inventory-list { background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 12px; margin-bottom: 8px; font-size: 13px; }
        .inventory-meta { float: right; font-weight: bold; color: var(--accent-teal); }

        .leverage-card { background: #0d1117; border: 1px solid #30363d; border-radius: 6px; padding: 14px; margin-bottom: 12px; }
        .model-tag { background: rgba(240, 136, 62, 0.15); color: var(--accent-orange); font-size: 10px; padding: 2px 8px; border-radius: 20px; font-weight: bold; text-transform: uppercase; display: inline-block; margin-bottom: 8px; }
        .model-title { font-size: 15px; font-weight: bold; color: #fff; margin-bottom: 4px; }
        .model-desc { font-size: 12px; color: var(--text-muted); line-height: 1.4; }
        .schedule-preview { background: #0d1117; border-left: 4px solid var(--accent-green); padding: 14px; border-radius: 4px; margin-top: 14px; font-family: monospace; white-space: pre-wrap; font-size: 12px; color: #fff; max-height: 180px; overflow-y: auto; }
        .btn-export { display: block; width: 100%; padding: 12px; background-color: var(--accent-green); color: #fff; border: none; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; margin-top: 16px; text-align: center; text-decoration: none; box-sizing: border-box; }
        .ad-placeholder { margin-top: 28px; border: 1px dashed #30363d; padding: 12px; text-align: center; font-size: 11px; color: var(--text-muted); border-radius: 6px; text-transform: uppercase; letter-spacing: 1px; }
    </style>
</head>
<body>

<div class="container">
    <h1>Ecosystem Master Hub v8.0</h1>
    <p class="subtitle">Complete Autonomous Freedom Matrix Engine</p>

    <!-- MODULE 1: ESCAPE FOOTPRINT ENGINE -->
    <h2 class="section-title" style="color: var(--accent-blue);">1. Escape Footprint Engine</h2>
    <div class="input-group">
        <label for="income">Monthly Corporate Income <span class="label-val blue-val">$<span id="income-txt">4000</span></span></label>
        <input type="number" id="income" value="4000" min="0" oninput="calculateEcosystem()">
    </div>
    <div class="input-group">
        <label for="expenses">Absolute Survival Costs <span class="label-val blue-val">$<span id="expenses-txt">2500</span></span></label>
        <input type="number" id="expenses" value="2500" min="0" oninput="calculateEcosystem()">
    </div>
    <div class="input-group">
        <label for="burnout">Job Misery Factor <span class="label-val blue-val"><span id="burnout-txt">7</span>/10</span></label>
        <input type="range" id="burnout" min="1" max="10" value="7" oninput="calculateEcosystem()">
    </div>
    <div class="results-box blue-b">
        <div class="result-item">
            <div class="result-label">Non-Linear Burnout Penalty (Compounding Curve)</div>
            <div class="result-value" id="burnout-penalty" style="color: var(--accent-red); font-size: 15px;">$0.00 / mo</div>
        </div>
        <div class="result-item" style="margin-top: 8px;">
            <div class="result-label">True Target Required for Freedom Balance</div>
            <div class="result-value" id="true-target" style="color: #56d364; font-size: 20px;">$0.00 / mo</div>
        </div>
    </div>

    <!-- MODULE 2: RATE PRICING ENGINE -->
    <h2 class="section-title" style="color: var(--accent-red);">2. Rate Pricing Engine</h2>
    <div class="input-group">
        <label for="hoursPerWeek">Weekly Production/Client Hours <span class="label-val red-val"><span id="hours-txt">20</span> hrs</span></label>
        <input type="range" id="hoursPerWeek" min="5" max="40" value="20" oninput="calculateEcosystem()">
    </div>
    <div class="input-group">
        <label for="overhead">Digital Tax & Software Buffer <span class="label-val red-val"><span id="overhead-txt">30</span>%</span></label>
        <input type="range" id="overhead" min="10" max="50" value="30" oninput="calculateEcosystem()">
    </div>
    <div class="results-box red-b">
        <div class="result-item">
            <div class="result-label">Unbillable Admin Friction Buffer</div>
            <div class="result-value" id="admin-cushion" style="color: var(--text-muted); font-size: 14px;">+$0.00 / hr</div>
        </div>
        <div class="result-item" style="margin-top: 8px;">
            <div class="result-label">Calculated Freedom Rate Requirement</div>
            <div class="result-value" id="final-rate" style="color: #56d364; font-size: 22px;">$0.00 / hr</div>
        </div>
    </div>

    <!-- MODULE 3: TRAFFIC VOLUME CORE -->
    <h2 class="section-title" style="color: var(--accent-purple);">3. Traffic Volume Core</h2>
    <div class="input-group">
